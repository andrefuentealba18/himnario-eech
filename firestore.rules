
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Apertura total de permisos para desarrollo y prototipado rápido.
    // Esto permite leer y escribir en cualquier colección (Himnos, Alabanzas, Coros, Agrupaciones, Ocasiones Especiales, etc.)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
