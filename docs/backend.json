
{
  "entities": {
    "Hymn": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hymn",
      "type": "object",
      "description": "Represents a single hymn in the Himnario EECH Móvil application, including its unique number, title, and complete lyrics.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Hymn entity."
        },
        "number": {
          "type": "number",
          "description": "The unique numerical identifier of the hymn within the hymnal."
        },
        "title": {
          "type": "string",
          "description": "The official title of the hymn."
        },
        "lyrics": {
          "type": "string",
          "description": "The complete text of the hymn's lyrics."
        },
        "keywords": {
          "type": "string",
          "description": "Additional keywords or phrases related to the hymn's content, aiding in search functionality."
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "lyrics"
      ]
    },
    "Praise": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Praise",
      "type": "object",
      "description": "Represents a single praise song, including its title, lyrics and tone.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Praise entity (slug of the title)."
        },
        "title": {
          "type": "string",
          "description": "The official title of the praise song."
        },
        "lyrics": {
          "type": "string",
          "description": "The complete text of the praise song's lyrics."
        },
        "tone": {
          "type": "string",
          "description": "The musical key of the praise song."
        },
        "speed": {
          "type": "string",
          "description": "The speed or rhythm of the song, for classification.",
          "enum": [
            "Rapido",
            "Lento"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "lyrics"
      ]
    },
    "Choir": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Choir",
      "type": "object",
      "description": "Represents a single choir song, including its title, lyrics and tone.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Choir entity (slug of the title)."
        },
        "title": {
          "type": "string",
          "description": "The official title of the choir song."
        },
        "lyrics": {
          "type": "string",
          "description": "The complete text of the choir song's lyrics."
        },
        "tone": {
          "type": "string",
          "description": "The musical key of the choir song."
        },
        "speed": {
          "type": "string",
          "description": "The speed or rhythm of the song, for classification.",
          "enum": [
            "Rapido",
            "Lento"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "lyrics"
      ]
    },
    "YouthChoir": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "YouthChoir",
      "type": "object",
      "description": "Represents a single song from church groups (Alabanzas de Agrupaciones).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the song entity (slug of the title)."
        },
        "title": {
          "type": "string",
          "description": "The official title of the song."
        },
        "lyrics": {
          "type": "string",
          "description": "The complete text of the song's lyrics."
        },
        "tone": {
          "type": "string",
          "description": "The musical key of the song."
        },
        "group": {
          "type": "string",
          "description": "The specific church group this song belongs to.",
          "enum": [
            "Coro Juventud",
            "Grupo Ciclista",
            "Departamento Infantil",
            "Clase Dorcas",
            "Departamento Juvenil"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "lyrics",
        "group"
      ]
    },
    "SpecialOccasion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SpecialOccasion",
      "type": "object",
      "description": "Represents songs for special church events (Weddings, Baptisms, etc).",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "lyrics": { "type": "string" },
        "tone": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "Bautismo",
            "Santa Cena",
            "Matrimonio",
            "Fúnebre",
            "Aniversario",
            "Campaña"
          ]
        }
      },
      "required": ["id", "title", "lyrics", "category"]
    },
    "Repertoire": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Repertoire",
      "type": "object",
      "description": "Represents a user-created repertoire or song list for a service.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "firstHymns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "number": { "type": "number" },
              "title": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "name", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "preferredFontSize": { "type": "number" }
      },
      "required": ["id"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/hymns/{hymnId}",
        "definition": {
          "entityName": "Hymn",
          "schema": { "$ref": "#/backend/entities/Hymn" },
          "description": "Public hymns."
        }
      },
      {
        "path": "/praises/{praiseId}",
        "definition": {
          "entityName": "Praise",
          "schema": { "$ref": "#/backend/entities/Praise" },
          "description": "Public praises."
        }
      },
      {
        "path": "/choirs/{choirId}",
        "definition": {
          "entityName": "Choir",
          "schema": { "$ref": "#/backend/entities/Choir" },
          "description": "Public choirs."
        }
      },
      {
        "path": "/youth-choirs/{youthChoirId}",
        "definition": {
          "entityName": "YouthChoir",
          "schema": { "$ref": "#/backend/entities/YouthChoir" },
          "description": "Group songs."
        }
      },
      {
        "path": "/special-occasions/{specialOccasionId}",
        "definition": {
          "entityName": "SpecialOccasion",
          "schema": { "$ref": "#/backend/entities/SpecialOccasion" },
          "description": "Songs for special occasions."
        }
      },
      {
        "path": "/repertoires/{repertoireId}",
        "definition": {
          "entityName": "Repertoire",
          "schema": { "$ref": "#/backend/entities/Repertoire" },
          "description": "Saved repertoires."
        }
      }
    ]
  }
}
